# ==== 默认：硅基流动 SiliconFlow（免费实用，注册即送额度）====
# 免费申请密钥: https://cloud.siliconflow.cn
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-你的硅基流动密钥
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ==== 备选：DeepSeek（把上面三行替换为下面三行）====
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-你的deepseek密钥
# LLM_MODEL=deepseek-chat

# ==== 可选参数 ====
# 温度，越高越有创造性
LLM_TEMPERATURE=0.7
# 最多保留多少条历史消息（防止上下文过长），0 表示不限制
LLM_MAX_HISTORY=20
# 请求超时（秒）
LLM_TIMEOUT=60
# 系统提示词
LLM_SYSTEM_PROMPT=你是高校教务政策知识库问答系统的AI助手，专门回答与高校教务政策相关的问题，回答简洁准确。
